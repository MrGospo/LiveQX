[Unit]
Description=LiveQX Engine
Documentation=file:/usr/share/doc/liveqx/SYSTEMD.md
After=network-online.target liveqx-mountd.service
Wants=network-online.target liveqx-mountd.service
# fix42: the helper daemon owns the AF_UNIX socket /run/liveqx/mountd.sock,
# and its unit file declares PartOf=liveqx.service — this gives a
# bidirectional stop/restart link. But PartOf= does not pull the helper up
# when the main service STARTS, so `systemctl restart liveqx`
# after a stop left mountd dead (see log 2026-05-22 23:51).
# Wants= closes the gap: starting liveqx now automatically brings the
# helper up. After= guarantees the socket exists by the time
# MountManager::reconcile() is called.

[Service]
Type=notify
NotifyAccess=main
# fix41: pass the config EXPLICITLY. Without --config the binary looks up
# a relative `config/default.json` from WorkingDirectory, and under an
# FHS install that file does not exist — the binary silently starts with
# an empty config and falls into headless mode (empty ui_dir, etc.).
# The production FHS config lives at /etc/liveqx/config.json.
ExecStart=/usr/local/bin/liveqx --config /etc/liveqx/config.json
WorkingDirectory=/var/lib/liveqx
Restart=on-failure
RestartSec=5s

# fix41: liveqx calls into liveqx-mountd for privileged operations.
# The helper authenticates the client by membership in the `liveqx` group
# (see RpcServer::authorizePeer), so the daemon must run as this user —
# otherwise either the privilege-separation model (root↔helper) breaks,
# or the peer fails socket authorization.
User=liveqx
Group=liveqx

# fix21: enable systemd watchdog. The process emits WATCHDOG=1 every
# WatchdogSec/2 from a background jthread (see SystemdNotifier). If the
# notifier loop hangs (e.g. ChannelManager deadlock) the unit is killed
# and restarted by Restart=on-failure.
WatchdogSec=30s

# Boundary: process needs network for SRT/RTMP/HLS/RTSP and a writable
# state dir for per-channel state.db + auth.db.
ReadWritePaths=/var/lib/liveqx
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

# fix44 c4: ReadWritePaths/ProtectSystem/PrivateTmp implicitly enable
# PrivateMounts=true, and the default MountFlags=private isolates the
# process from mount events that happen in the system namespace AFTER it
# starts. liveqx-mountd (root) mounts CIFS shares dynamically on request
# from the UI — without MountFlags=slave those mounts never appear in
# the liveqx namespace, and the Watcher sees an autofs stub with no CIFS
# under it (UI: "Files cached: 0").
#
# slave gives one-way propagation from outside in (which is what we need),
# and changes from the inside do not leak outward — the sandbox is kept.
# shared would be overkill: liveqx does not call mount(2).
MountFlags=slave

# ── Master-key delivery via systemd-creds (production recommendation) ──────
# By default the daemon auto-generates /var/lib/liveqx/master.key
# (mode 0600) on first start. That works, but the key ends up on the same
# disk as auth.db — anyone who steals a backup or VM snapshot gets both.
#
# Better: keep the key encrypted at rest with a TPM2-bound systemd-creds
# blob, and let systemd hand the plaintext to the service via a tmpfs.
# Setup once on the target host:
#
#     # 1. Generate a 32-byte random key in base64.
#     KEY=$(openssl rand -base64 32)
#
#     # 2. Encrypt it under this host's TPM (or machine-id if no TPM).
#     #    The output file can sit in /etc — without the TPM it is opaque.
#     sudo mkdir -p /etc/credstore.encrypted
#     echo -n "$KEY" | sudo systemd-creds encrypt --name=streaming_master_key \
#         - /etc/credstore.encrypted/streaming_master_key
#     unset KEY
#
# Then uncomment the two lines below. systemd will decrypt the credential
# into $CREDENTIALS_DIRECTORY (tmpfs, 0400, only this service can read it)
# and the daemon will pick it up via LIVEQX_MASTER_KEY_FILE.
#
# LoadCredentialEncrypted=streaming_master_key:/etc/credstore.encrypted/streaming_master_key
# Environment=LIVEQX_MASTER_KEY_FILE=%d/streaming_master_key
#
# Migration from auto-generated key: see docs/AUTH.md §10 — you must
# re-encrypt the existing master.key contents into the credstore (or
# accept a hard reset of LDAP/SMTP/JWT secrets via auth-cli reset).

# Logging — journald will absorb stdout/stderr. Status set via sd_notify
# (STATUS=…) is visible in `systemctl status liveqx`.
StandardOutput=journal
StandardError=journal

# Resource hints — tune per host. The render pipeline pins worker threads
# itself (see CpuAffinity + numa_node), so do NOT use CPUAffinity= here:
# it would override the per-channel pinning.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
