[Unit]
Description=LiveQX mount-namespace bootstrap (shared propagation for /mnt/liveqx)
Documentation=file:/usr/share/doc/liveqx/MOUNTS.md
DefaultDependencies=no
After=local-fs.target
Before=liveqx-mountd.service liveqx.service

[Service]
Type=oneshot
RemainAfterExit=yes

# fix44 c6: the previous attempt (c5) kept these ExecStartPre inside
# liveqx-mountd.service itself with the '+' prefix. On systemd 255 the '+'
# prefix drops only privilege-related restrictions (User=, ProtectSystem=, ...),
# but does NOT disable PrivateMounts=/PrivateTmp=. mountd has PrivateTmp=true,
# so ExecStartPre ran in its private mount-namespace, where
# /mnt/liveqx is already propagated via slave from the system namespace.
# Trying `mount --bind` over such a point on WSL2 returns
# Unknown error 5005 (the kernel dislikes a recursive bind on a slave-mountpoint
# with active submounts).
#
# Fix: move the preparation into a separate unit WITHOUT a sandbox, so the
# commands are guaranteed to run in the system namespace. Once
# /mnt/liveqx is marked make-shared in the system namespace, any
# child mount events (CIFS from mountd) also reach the slave-namespace
# of liveqx (see MountFlags=slave in liveqx.service).
#
# DefaultDependencies=no + After=local-fs.target — run early,
# before the other units start. RequiredBy=liveqx-mountd.service
# guarantees that without a successful init mountd will not come up either.

ExecStart=/bin/mkdir -p /mnt/liveqx
ExecStart=/bin/sh -c 'mountpoint -q /mnt/liveqx || mount --bind /mnt/liveqx /mnt/liveqx'
ExecStart=/bin/mount --make-shared /mnt/liveqx

# fix44 c7: if liveqx is already running at the moment this unit is
# (re)started — restart it. A slave-namespace subscribes to the parent's
# peer group at clone time; if liveqx started BEFORE we ran make-shared,
# its namespace stays without a subscription, and new CIFS mounts are not
# propagated.
#
# Cases:
#  • boot: liveqx is not active yet → is-active returns false, no-op.
#    Afterwards, per After=, systemd starts it under an already-shared parent. OK.
#  • installing fix44 on top of a running service: is-active=true →
#    try-restart recreates the namespace with the correct subscription. OK.
#  • reinstalling / editing mount-init: same thing, auto-restart.
#
# '-' suppresses try-restart errors (for example, if the service is in a
# transition state at that moment). try-restart (not restart) is safe when
# the service is stopped — it becomes a no-op instead of forcing a start.
ExecStartPost=-/bin/sh -c 'systemctl is-active --quiet liveqx.service && systemctl try-restart liveqx.service'

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=liveqx-mountd.service
