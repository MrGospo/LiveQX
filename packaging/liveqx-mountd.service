[Unit]
Description=LiveQX mount helper (privileged, manages CIFS/NFS mounts on behalf of liveqx)
Documentation=file:/usr/share/doc/liveqx/MOUNTS.md
After=local-fs.target liveqx-mount-init.service
Requires=liveqx-mount-init.service
Before=liveqx.service
PartOf=liveqx.service

[Service]
Type=simple

# fix44 c6: preparing shared propagation for /mnt/liveqx has been split
# out into a separate oneshot unit liveqx-mount-init.service. Reason —
# in c5 these commands lived as ExecStartPre with the '+' prefix, but on
# systemd 255 '+' does NOT drop PrivateTmp/PrivateMounts (see the list of
# exceptions in systemd.exec(5)). mountd has PrivateTmp=true → the
# commands ran in its private namespace, where a bind-mount over a
# slave-propagated /mnt/liveqx with active submounts failed with error 5005
# on WSL2.

ExecStart=/usr/local/bin/liveqx-mountd
Restart=on-failure
RestartSec=2s

# The helper must be root to call systemctl daemon-reload, write into
# /etc/systemd/system, write cred files into /run/liveqx/creds,
# and execute mount(8). The control socket is then chmod'd 0660
# root:liveqx in the helper's start() routine before listen() —
# only the liveqx service user can reach it.
#
# fix42: Group=liveqx (not root). uid stays 0 → all root caps
# preserved (mount(2), credstore writes, daemon-reload). But primary
# gid = liveqx, so RuntimeDirectory below is created as
# root:liveqx 0750 — without this the main service running as liveqx
# cannot even enter /run/liveqx/ to open the socket (EACCES on connect).
# Reproduced 2026-05-23.
User=root
Group=liveqx

# Where the AF_UNIX control socket lives. RuntimeDirectory creates the
# directory at unit-start; mode 0750 root:liveqx means only the
# liveqx service user can stat() the socket file but cannot
# create files of its own there.
RuntimeDirectory=liveqx
RuntimeDirectoryMode=0750

# We need write access to /etc/systemd/system (write generated unit
# files) and /run/liveqx (control socket + creds tmpfs).
# Everything else stays read-only.
#
# fix43: /etc/credstore.encrypted and /var/lib/systemd removed — the helper
# no longer uses systemd-creds(1). Cred files are written in plaintext to
# the tmpfs /run/liveqx/creds (mkdir + chmod 0700 in mountd at startup;
# see MountdMain.cpp). LoadCredentialEncrypted= in [Mount] units does not
# work on systemd 255 — it is silently accepted and does not create
# /run/credentials/<unit>/, breaking mount.cifs with error(2). See CredsHelper.h.
ProtectSystem=strict
ReadWritePaths=/etc/systemd/system /run/liveqx /run/systemd
PrivateTmp=true
NoNewPrivileges=false

# We deliberately do NOT set ProtectKernelTunables / ProtectKernelModules
# because mount(8) for CIFS may need to load the cifs.ko module on first
# use. ProtectControlGroups stays default (we don't touch cgroups).

StandardOutput=journal
StandardError=journal

# Tight memory cap — the helper is essentially stateless and never
# touches the data plane. Anything close to this would be a bug.
MemoryMax=128M
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
